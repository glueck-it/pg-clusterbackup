hostname             = "db01.example.com"
backupdir            = "/data/backup/postgresql"
tempdir              = "/data/backup/postgresql/.tmp"
email                = "monitor@example.com"
maxkeep              = "14"
format               = "c"
logdir               = "/data/backup/postgresql/log"
debug_level          = "1"
parallel_jobs        = "4"
parallel_clusters    = "2"
exclude_databases    = "test_*,*_tmp,cache"
include_databases    = ""
min_free_space_gb    = "10"
compression          = "6"
ping_url             = "https://hc-ping.com/your-uuid-here"
